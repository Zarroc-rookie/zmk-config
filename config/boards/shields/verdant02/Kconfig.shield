# Canonical ZMK shield form: auto-set SHIELD_VERDANT02=y when `-DSHIELD=verdant02`.
# Do NOT add `depends on BOARD_*` here — undefined board symbols trip
# Zephyr's strict Kconfig mode (KCONFIG_WARN_UNDEF) and abort the build
# with "Aborting due to Kconfig warnings". Board compatibility is enforced
# at the devicetree level via nRF-specific &gpio0/&gpio1 references in
# verdant02.overlay.
config SHIELD_VERDANT02
    def_bool $(shields_list_contains,verdant02)
