 * Copyright (c) 2026 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Verdant02 Keymap — 1:1 replica of the original QMK default layout
 *
 * Matrix position ordering (must match the .overlay matrix_transform map):
 *   Phys Row 0  (14) :  [0][0][4][0][0][1][4][1][0][2][3][2][0][3][3][3][0][4][3][4][0][5][4][5][0][6][4][6]
 *   Phys Row 1  (13) :  [1][0][5][0][1][1][5][1][1][2][4][2][1][3][4][3][1][4][4][4][1][5][5][5][1][6]
 *   Phys Row 2  (14) :  [2][0][6][0][2][1][6][1][2][2][5][2][2][3][5][3][2][4][5][4][2][5][6][5][2][6][5][6]
 *   Phys Row 3  (13) :  [3][0][7][0][3][1][7][1][6][2][6][3][7][3][6][4][3][5][3][6][7][5][6][6][7][6]
 *   Total = 14 + 13 + 14 + 13 = 54 bindings.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ===== Layer 0: QWERTY BASE (matches original QMK _BASE) ===== */
        default_layer {
            label = "Base";
            bindings = <
/* Phys Row 0  [14] Del  Q  W  E  R  T  Y  U  I  O  P  [  ]  Ent                */
&kp DEL  &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &kp LBKT &kp RBKT &kp RET
/* Phys Row 1  [13] Tab  A  S  D  F  G  H  J  K  L  ;  '  #                     */
&kp TAB  &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp SQT  &kp HASH
/* Phys Row 2  [14] LSh  \  Z  X  C  V  B  N  M  ,  .  /  FN1  RSh               */
&kp LSHFT&kp BSLH &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA&kp DOT  &kp FSLH &mo 1    &kp RSHFT
/* Phys Row 3  [13] LCtl LGUI FN2 LAlt Spc Spc FN1 BkSp ←  ↓  ↑  →  Mute          */
&kp LCTL &kp LGUI &mo 2    &kp LALT &kp SPACE&kp SPACE&mo 1    &kp BSPC &kp LEFT &kp DOWN &kp UP   &kp RIGHT&kp MUTE
            >;
        };

        /* ===== Layer 1: NUMBERS + FUNCTION (FN1, original QMK _FN1) ===== */
        fn1_layer {
            label = "FN1";
            bindings = <
/*            Esc  1  2  3  4  5  6  7  8  9  0  -  =  BkSp                     */
&kp ESC  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp MINUS&kp EQUAL&kp BSPC
/*            LGUI F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12                          */
&kp LGUI &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12
/*            _    _  TOG MOD _  _  _  _  _  _  _  _  _  Reset(Boot)               */
&trans   &trans   &rgb_tog &rgb_mod &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &bootloader
/*            _    _  _  _  _  _  _  _  _  _  _  _  _                              */
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };

        /* ===== Layer 2: NAV + EDIT (FN2, original QMK _FN2) ===== */
        fn2_layer {
            label = "FN2";
            bindings = <
/*            _    _  _  END _  _  _  _  INS _  PSCR _  _  _                       */
&trans   &trans   &trans   &kp END  &trans   &trans   &trans   &trans   &kp INS  &trans   &kp PSCRN&trans   &trans   &trans
/*            _    _  _  DEL _  _  HOM _  _  _  _  _  _                            */
&trans   &trans   &trans   &kp DEL  &trans   &trans   &kp HOME &trans   &trans   &trans   &trans   &trans   &trans
/*            _    _  _  _  _  _  _  _  _  _  _  _  _  _                            */
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
/*            _    _  _  _  _  _  _  _  _  PGDN PGUP _  _                          */
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp PG_DN&kp PG_UP&trans   &trans
            >;
        };
    };
};
