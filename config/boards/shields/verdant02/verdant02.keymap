/*
 * Copyright (c) 2026 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Verdant02 default keymap (3 layers).
 *
 * 54 bindings per layer; order matches QMK Firmware/verdant02/Verdant02.h:
 *   Phys Row 0: 14 keys
 *   Phys Row 1: 13 keys
 *   Phys Row 2: 14 keys
 *   Phys Row 3: 13 keys
 *
 * KEYCODE RULE (to avoid "expected number" parse errors):
 *   Every &kp keycode below MUST appear as a #define in
 *   dt-bindings/zmk/keys.h. NO guesswork, no undocumented short names.
 *   - SINGLE_QUOTE / NON_US_HASH / BACKSLASH / FSLH / SEMI all verified
 *     in ZMK v0.3.0 keys.h.
 *   - BOOTLOADER is NOT a keycode; use &bootloader behavior reference.
 *   - MUTE is NOT a keycode; use &kp C_MUTE (Consumer page).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        /* Long-press 2s to clear BT pairing. Tap = no-op (&trans). */
        bt_clr_hold: bt_clr_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            tapping-term-ms = <2000>;
            bindings = <&bt BT_CLR>, <&trans>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ============== Layer 0: BASE (ANSI 40%) ============== */
        default_layer {
            display-name = "Base";
            bindings = <
&kp DELETE &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp RETURN
&kp TAB &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SINGLE_QUOTE &kp NON_US_HASH
&kp LSHIFT &kp BACKSLASH &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &kp FSLH &mo 1 &kp RSHIFT
&kp LCTRL &kp LGUI &mo 2 &kp LALT &kp SPACE &kp SPACE &mo 1 &kp BACKSPACE &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp C_MUTE
            >;
        };

        /* ============== Layer 1: NUM + FUNC (_FN1) ============== */
        fn1_layer {
            display-name = "FN1";
            bindings = <
&kp ESCAPE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BACKSPACE
&kp LGUI &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &bootloader
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &bt_clr_hold &out OUT_USB &out OUT_BLE
            >;
        };

        /* ============== Layer 2: NAV + EDIT (_FN2) ============== */
        fn2_layer {
            display-name = "FN2";
            bindings = <
&trans &trans &trans &kp END &trans &trans &trans &trans &kp INSERT &trans &kp PSCRN &trans &trans &trans
&trans &trans &trans &kp DELETE &trans &trans &kp HOME &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &kp PG_DN &kp PG_UP &trans &trans
            >;
        };
    };
};
