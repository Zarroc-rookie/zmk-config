if SHIELD_VERDANT02

# Diode direction is enforced declaratively in verdant02.dtsi via
#   kscan0.diode-direction = "col2row",
# which takes precedence over Kconfig. We intentionally do NOT set
# ZMK_KSCAN_MATRIX_COL2ROW / ROW2COL here because their type and
# symbol name changed between ZMK releases and the Kconfig warnings
# abort the build under strict mode.

endif
